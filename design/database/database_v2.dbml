// Docs: https://dbml.dbdiagram.io/docs
// database structure : Security Information System (SIS)
// author : theadamz91@gmail.com

// config

// config - setup
Table entities {
    id bigint [primary key, not null]
    code varchar(3) [not null, unique]
    name varchar(50) [not null]
    description varchar(100)
    is_active boolean [not null, default: true]
}

Table sites {
    id bigint [primary key, not null]
    entity_id bigint [not null]
    code varchar(6) [not null]
    name varchar(50) [not null]
    address varchar(150) [not null]
    timezone varchar(50) [not null, default: 'Asia/Jakarta']
    is_active boolean [not null, default: true]

    indexes {
        entity_id
        code
        (entity_id, code) [unique]
    }

}

// relation sites
Ref: sites.entity_id > entities.id [delete: restrict, update: cascade]

Table gates {
    id bigint [pk, not null]
    site_id bigint [not null]
    code varchar(15) [not null]
    name varchar(50) [not null]
    is_active boolean [not null, default: true]

    indexes {
        site_id
        (site_id, code) [unique]
    }

}

// relation gates
Ref: gates.site_id > sites.id [delete: restrict, update: cascade]

Table users {
    id bigint [primary key, not null]
    email varchar(255) [not null, unique]
    name varchar(255) [not null]
    password varchar(255) [not null]
    def_path varchar(255) [default: '/']
    site_id bigint [not null]
    is_active bool [not null, default: true]
    email_verified_at timestamp
    last_change_password_at timestamp
    last_login_at timestamp
    remember_token varchar(100)

    indexes {
        site_id
    }

}

// relation users
Ref: users.site_id > sites.id [delete: restrict, update: cascade]

Table site_accesses {
    id bigint [primary key, not null]
    site_id bigint [not null]
    user_id bigint [not null]
    is_allowed boolean [not null, default: true]

    indexes {
        user_id
        site_id
        (user_id, site_id) [unique]
    }

}

// relation site_accesses
Ref: site_accesses.user_id > users.id [delete: restrict, update: cascade]
Ref: site_accesses.site_id > sites.id [delete: restrict, update: cascade]

Table accesses {
    id bigint [primary key, not null]
    site_id bigint [not null]
    user_id bigint [not null]
    code varchar(50) [not null]
    permission varchar(20) [not null, note: "read,edit,delete,validation,etc"]
    is_allowed bool [not null, default: true]

    indexes {
        site_id
        user_id
        code
        (site_id, user_id, code, permission) [unique]
    }

}

// relation accesses
Ref: accesses.site_id > sites.id [delete: restrict, update: cascade]
Ref: accesses.user_id > users.id [delete: restrict, update: cascade]

Table sign_in_histories {
    id bigint [primary key, not null]
    ip varchar(255) [not null]
    os varchar(255)
    platform varchar(255)
    browser varchar(255)
    country varchar(255)
    city varchar(255)
    user_id bigint [not null]
    created_at timestamp [default: `now()`]

    indexes {
        ip
        user_id
    }

}

// relation sign_in_histories
Ref: sign_in_histories.user_id > users.id [delete: restrict, update: cascade]

// ./ config - setup

// config - inspection
Table inspection_categories {
    id bigint [pk, not null]
    code varchar(50) [unique, not null]
    name varchar(100) [not null]
    is_active bool [not null, default: true]
}

// records inspection_categories
Records inspection_categories(id, code, name) {
    1, 'MT', 'Motor'
    2, 'WB', 'Wingbox'
    3, 'TR', 'Trailer'
    4, 'GU', 'Gudang'
    5, 'RG', 'Ruangan'
    6, 'GE', 'Gedung'
}

Table inspection_flows {
    id bigint [pk, not null]
    inspection_category_id bigint [not null]
    name varchar(100) [not null]
    description varchar(255)
}

// relation inspection_flows
Ref: inspection_flows.inspection_category_id > inspection_categories.id

// records inspection_flows
Records inspection_flows(id, inspection_category_id, name) {
    1, 1, 'Motor Muat Barang'
    2, 2, 'Wingbox Bongkar Barang'
    3, 3, 'Trailer Muat Barang'
    4, 4, 'Pemeriksaan Gudang'
}

Table inspection_flow_stages {
    id bigint [pk, not null]
    inspection_flow_id bigint [not null]
    name varchar(100) [not null]
    order smallint

    indexes {
        inspection_flow_id
        order
        (inspection_flow_id, order) [unique]
    }

}

// relation inspection_flow_stages
Ref: inspection_flow_stages.inspection_flow_id > inspection_flows.id

// records inspection_flow_stages
Records inspection_flow_stages(id, inspection_flow_id, name, order) {
    1, 1, 'Loading', 1
    2, 2, 'Check in', 1
    3, 2, 'Unloading', 2
    4, 2, 'Check out', 3
    5, 3, 'Check in', 1
    6, 3, 'Loading', 2
    7, 3, 'Check out', 3
    8, 4, 'Patroli', 1
}

Table inspection_forms {
    id bigint [primary key, not null]
    inspection_type varchar(20) [not null, default: 'VEHICLE']
    inspection_flow_stage_id bigint [not null]
    code varchar(50) [unique, not null, note: "INS/24/001"]
    name varchar(100) [not null]
    is_publish bool [default: true]

    indexes {
        inspection_flow_stage_id
        inspection_type
    }

}

// relation inspection_forms
Ref: inspection_forms.inspection_flow_stage_id > inspection_flow_stages.id [delete: cascade, update: cascade]

Table inspection_vehicle_forms {
    id bigint [primary key, not null]
    inspection_form_id bigint [not null]
    use_eta_dest bool [not null, default: false, note: "Flag to show Estimation Time Arrival datetime in form inspection"]
    use_ata_dest bool [not null, default: false, note: "Flag to show Actual Time Arrival datetime in form inspection"]
    stage varchar(20) [not null, default: "[CHECKED_IN, LOADING/UNLOADING, CHECKED_OUT]"]

    indexes {
        inspection_form_id
        stage
        (inspection_form_id, stage) [unique]
    }

}

// relation inspection_vehicle_forms
Ref: inspection_vehicle_forms.inspection_form_id > inspection_forms.id [delete: cascade, update: cascade]

Table inspection_vehicle_form_sections {
    id bigint [primary key, not null]
    inspection_vehicle_form_id bigint [not null]
    description varchar(200) [not null]
    seq smallint [not null, default: 1]
    is_separate_page bool [default: false, note: "flag print in new page"]

    indexes {
        inspection_vehicle_form_id
        seq
        (inspection_vehicle_form_id, seq) [unique]
    }

}

// relation inspection_vehicle_form_sections
Ref: inspection_vehicle_form_sections.inspection_vehicle_form_id > inspection_vehicle_forms.id [delete: cascade, update: cascade]

Table inspection_vehicle_form_items {
    id bigint [primary key, not null]
    inspection_vehicle_form_section_id bigint [not null]
    description varchar(200) [not null]
    item_type varchar(20) [not null, default: "select/photo/both"]
    seq smallint [not null, default: 1]

    indexes {
        inspection_vehicle_form_section_id
        item_type
        seq
        (inspection_vehicle_form_section_id, seq) [unique]
    }

}

// relation inspection_vehicle_form_items
Ref: inspection_vehicle_form_items.inspection_vehicle_form_section_id > inspection_vehicle_form_sections.id [delete: cascade, update: cascade]

// ./ config

// inspection

Table registered_vehicles {
    id bigint [primary key, not null]
    ownership varchar(50) [not null, note: "internal,employee,vendor,forwarder/ekspeditur"]
    reg_no varchar(50) [unique, not null, note: "Vehicle registration number"]
    owner_name varchar(255)
    owner_address varchar(255)
    paper_no varchar(50) [note: "Vehicle registration number paper"]
    brand varchar(255) [note: "Brand, ex: YAMAHA"]
    type varchar(255) [note: "Type, ex: 2DP NON ABS"]
    category varchar(255) [note: "Category, ex: SEPEDA MOTOR"]
    model varchar(255) [note: "Model, ex: SPD MOTOR SOLO"]
    production_year smallint
    power_capacity int [note: "cylinder capacity / electrical power"]
    chassis_no varchar(255)
    engine_no varchar(255)
    color varchar(255)
    fuel_type varchar(255) [note: "SOLAR/BENSIN"]
    license_plate_color varchar(255)
    registration_year smallint
    registered_for varchar(255) [note: "employee name or PIC for the vehicle"]

    indexes {
        ownership
        reg_no
        chassis_no
        engine_no
    }

}

Table inspection_documents {
    id bigint [primary key, not null]
    site_id bigint [not null]
    inspection_type varchar(20) [not null, default: 'VEHICLE']
    inspection_no varchar(50) [not null, unique]
    inspection_date date [not null]
    inspection_flow_id bigint [not null]
    current_inspection_flow_stage_id bigint [not null]
    status varchar(20) [not null, default: 'DRAFT', note: 'DRAFT,POSTED,DISCARDED']

    indexes {
        site_id
        inspection_type
        inspection_date
        inspection_flow_id
        current_inspection_flow_stage_id
        status
    }

}

// relation inspection_documents
Ref: inspection_documents.site_id > sites.id [delete: restrict, update: cascade]
Ref: inspection_documents.inspection_flow_id > inspection_flows.id [delete: restrict, update: cascade]
Ref: inspection_documents.current_inspection_flow_stage_id > inspection_flow_stages.id [delete: restrict, update: cascade]

Table inspection_document_logs {
    id bigint [primary key, not null]
    inspection_document_id bigint [not null]
    user_id bigint [not null]
    description text [not null]
}

// relation inspection_document_logs
Ref: inspection_document_logs.inspection_document_id > inspection_documents.id [delete: cascade, update: cascade]
Ref: inspection_document_logs.user_id > users.id [delete: cascade, update: cascade]

Table vehicle_inspections {
    id bigint [primary key, not null]
    inspection_document_id bigint [not null]
    inspection_date date [not null]
    inspection_form_id bigint [not null]
    inspected_by bigint [not null]
    gate_id bigint [not null]
    container_no varchar(100)
    seal_no varchar(100)
    // vehicle_reg_no varchar(50) [not null, note: "Vehicle registration number"]
    // vehicle_paper_no varchar(50) [note: "Vehicle registration number paper"]
    registered_vehicle_id bigint [not null]
    driver_id_no varchar(50) [not null, note: "Driver identity card ex: driver license"]
    driver_name varchar(100) [not null]
    driver_phone_no varchar(20) [not null]
    arrival_time_at_fty timestamp [note: "Time arrived in factory to loading / unloading"]
    depart_time_from_fty timestamp [note: "Time depart from factory to export"]
    eta_to_dest timestamp [note: "Estimation time to destination harbour / airport"]
    ata_to_dest timestamp [note: "Actual time arrived at destination harbour / airport"]
    duration_start timestamp [note: "With flag use duration"]
    duration_end timestamp [note: "With flag use duration"]
    export_notified_by varchar(100) [note: "Notified to Export Departure by (name)"]
    remarks varchar(255)
    inspection_started_at timestamp
    inspection_ended_at timestamp
    coordinate_start jsonb
    coordinate_end jsonb
    reviewed_by bigint
    reviewed_at timestamp
    reviewed_comment varchar(255)

    indexes {
        inspection_document_id
        inspection_date
        inspection_form_id
        inspected_by
        gate_id
        container_no
        seal_no
        // vehicle_reg_no
        // vehicle_paper_no
        registered_vehicle_id
        driver_id_no
        driver_phone_no
        arrival_time_at_fty
        depart_time_from_fty
        reviewed_by
    }

}

// relation vehicle_inspections
Ref: vehicle_inspections.inspection_document_id > inspection_documents.id [delete: restrict, update: cascade]
Ref: vehicle_inspections.inspection_form_id > inspection_forms.id [delete: restrict, update: cascade]
Ref: vehicle_inspections.inspected_by > users.id [delete: restrict, update: cascade]
Ref: vehicle_inspections.gate_id > gates.id [delete: restrict, update: cascade]
Ref: vehicle_inspections.reviewed_by > users.id [delete: restrict, update: cascade]
Ref: vehicle_inspections.registered_vehicle_id > registered_vehicles.id [delete: restrict, update: cascade]

Table vehicle_inspection_item_checks {
    id bigint [primary key, not null]
    vehicle_inspection_id bigint [not null]
    inspection_vehicle_form_item_id bigint [not null]
    result jsonb [not null, note: '{ type: "SELECT", value: true/false, picture_file: "image.webp" }']
    remarks varchar(100)

    indexes {
        vehicle_inspection_id
        inspection_vehicle_form_item_id
        (vehicle_inspection_id, inspection_vehicle_form_item_id) [unique]
    }

}

// relation vehicle_inspection_item_checks
Ref: vehicle_inspection_item_checks.vehicle_inspection_id > vehicle_inspections.id [delete: restrict, update: cascade]
Ref: vehicle_inspection_item_checks.inspection_vehicle_form_item_id > inspection_vehicle_form_items.id [delete: restrict, update: cascade]

Table vehicle_inspection_item_pictures {
    id bigint [primary key, not null]
    inspection_id bigint [not null]
    pic_file varchar(50) [note: "filename.jpg"]
}

// relation vehicle_inspection_item_pictures
Ref: vehicle_inspection_item_pictures.inspection_id > vehicle_inspections.id [delete: restrict, update: cascade]

Table document_sequences {
    id bigint [primary key, not null]
    site_id bigint [not null]
    type varchar(20) [not null, note: "VEHICLE/ROOM"]
    year tinyint [not null]
    month tinyint [not null]
    next_no tinyint [not null, default: 1]

    indexes {
        site_id
        type
        (type, site_id, year, month) [unique]
    }

}

// relation document_sequences
Ref: document_sequences.site_id > sites.id [delete: cascade, update: cascade]

// ./ inspection
